{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapsis.dev/contracts/orchestrator-v1.json",
  "title": "Orchestrator Agent Contract",
  "description": "Central coordinator that decomposes user queries into tasks, routes them to agents, and supervises execution. The only agent that communicates with all others.",
  "type": "object",
  "required": ["agent_id", "agent_type", "capabilities", "input_schema", "output_schema"],
  "properties": {
    "agent_id": {
      "type": "string",
      "const": "orchestrator-v1"
    },
    "agent_type": {
      "type": "string",
      "const": "orchestrator"
    },
    "capabilities": {
      "type": "array",
      "description": "High-level capabilities the Orchestrator can perform",
      "items": {
        "type": "string",
        "enum": [
          "decompose_task",
          "route_to_agent",
          "spawn_debate",
          "monitor_timeout",
          "aggregate_results",
          "escalate_to_user",
          "manage_blackboard",
          "replan_on_failure"
        ]
      }
    },
    "input_schema": {
      "type": "object",
      "required": ["user_query", "session_id"],
      "properties": {
        "user_query": {
          "type": "string",
          "description": "Raw user input as text. If voice input was used, this is the transcribed text from Voice Listener.",
          "minLength": 1,
          "maxLength": 4000
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique session identifier. Created once per conversation, persists across multiple queries."
        },
        "preferences": {
          "type": "object",
          "description": "User-configurable settings loaded at session start",
          "properties": {
            "code_execution_enabled": {
              "type": "boolean",
              "default": true,
              "description": "If false, Coder generates code but never executes it"
            },
            "voice_output_enabled": {
              "type": "boolean",
              "default": false,
              "description": "If true, final response is also sent to Voice Speaker"
            },
            "vault_path": {
              "type": "string",
              "description": "Filesystem path to Obsidian vault for Librarian"
            },
            "max_sandbox_timeout_seconds": {
              "type": "integer",
              "default": 120,
              "minimum": 10,
              "maximum": 300
            },
            "max_debate_rounds": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 10
            },
            "max_agent_retries": {
              "type": "integer",
              "default": 3,
              "minimum": 0,
              "maximum": 5
            }
          }
        }
      }
    },
    "output_schema": {
      "type": "object",
      "required": ["session_id", "status", "final_response"],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "partial", "failed", "cancelled", "timeout"]
        },
        "plan": {
          "type": "object",
          "description": "The task decomposition generated by Planner",
          "properties": {
            "original_query": {
              "type": "string"
            },
            "decomposed_tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["task_id", "description", "assigned_agent", "status"],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "pattern": "^task-[a-z0-9]+$"
                  },
                  "description": {
                    "type": "string",
                    "description": "Human-readable description of what this task does"
                  },
                  "assigned_agent": {
                    "type": "string",
                    "enum": ["librarian-v1", "coder-v1", "critic-v1", "scribe"]
                  },
                  "dependencies": {
                    "type": "array",
                    "description": "task_ids that must complete before this task starts",
                    "items": {
                      "type": "string"
                    }
                  },
                  "status": {
                    "type": "string",
                    "enum": ["pending", "in_progress", "completed", "failed", "skipped"]
                  },
                  "blackboard_keys": {
                    "type": "array",
                    "description": "Keys on the Blackboard where this task's output was written",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "agent_results": {
          "type": "object",
          "description": "Aggregated results from all invoked agents, keyed by agent_id",
          "additionalProperties": {
            "type": "object"
          }
        },
        "final_response": {
          "type": "string",
          "description": "The complete text response to show the user. Formatted by Scribe."
        },
        "voice_audio_path": {
          "type": "string",
          "description": "Filesystem path to generated TTS audio file. Only present if voice_output_enabled is true and Speaker was invoked.",
          "examples": ["/tmp/synapsis-audio/session-abc123-response.wav"]
        },
        "execution_summary": {
          "type": "object",
          "description": "Metadata about the execution for debugging and session history",
          "properties": {
            "total_time_ms": {
              "type": "number"
            },
            "agents_invoked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "debates_spawned": {
              "type": "integer"
            },
            "sandbox_executions": {
              "type": "integer"
            },
            "errors_encountered": {
              "type": "integer"
            },
            "blackboard_entries_created": {
              "type": "integer"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Present only if status is 'failed' or 'timeout'",
          "properties": {
            "error_type": {
              "type": "string",
              "enum": ["planning_failed", "agent_timeout", "debate_deadlock", "sandbox_error", "config_error"]
            },
            "message": {
              "type": "string"
            },
            "failed_task_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "peer_agents": {
      "type": "array",
      "description": "Agents the Orchestrator can assign tasks to",
      "items": {
        "type": "string"
      },
      "default": ["librarian-v1", "coder-v1", "critic-v1"]
    },
    "timeout_seconds": {
      "type": "integer",
      "description": "Maximum time for the entire orchestration cycle. After this, the Orchestrator returns a partial result or escalates.",
      "default": 300
    },
    "retry_policy": {
      "type": "object",
      "properties": {
        "max_retries": {
          "type": "integer",
          "default": 1,
          "description": "How many times to retry the entire orchestration on failure"
        },
        "backoff_strategy": {
          "type": "string",
          "enum": ["linear"],
          "default": "linear"
        }
      }
    }
  }
}