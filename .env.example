# ============================================
# Synapsis Configuration
# Copy this file to .env and fill in your values
# ============================================

# ─── LLM Provider ────────────────────────────
# Groq API key (free tier available)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Groq model to use
# Options: llama-3.1-8b-instant, llama-3.1-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-70b-versatile

# DeepSeek API key (optional, for future multi-provider support)
# Get one at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ─── Obsidian Vault ──────────────────────────
# Absolute path to your Obsidian vault
# Example: /home/egor/ObsidianVault
#          C:\Users\Egor\Documents\ObsidianVault
OBSIDIAN_VAULT_PATH=

# ─── Memex RAG ───────────────────────────────
# Memex index location
# Default: {vault_path}/.memex
# MEMEX_INDEX_PATH=

# ─── Voice I/O ───────────────────────────────
# Speech-to-Text engine
# Options: whisper_local, whisper_api
VOICE_STT_ENGINE=whisper_local

# Whisper model size (smaller = faster, larger = more accurate)
# Options: tiny, base, small, medium, large
WHISPER_MODEL=base

# Whisper language (auto-detect if empty)
# Example: en, ru, auto
WHISPER_LANGUAGE=

# Text-to-Speech engine
# Options: piper_local, elevenlabs
VOICE_TTS_ENGINE=piper_local

# Piper voice model
# Options: en_US-lessac-medium, en_US-amy-medium, etc.
# Full list: https://huggingface.co/rhasspy/piper-voices
PIPER_VOICE=en_US-lessac-medium

# ElevenLabs API key (only needed if VOICE_TTS_ENGINE=elevenlabs)
# Get one at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# ─── Sandbox ─────────────────────────────────
# Maximum execution time for sandboxed code (seconds)
SANDBOX_TIMEOUT_SECONDS=120

# Maximum memory for sandbox subprocess (MB)
SANDBOX_MAX_MEMORY_MB=512

# Allow packages outside the whitelist (dangerous!)
# true or false
SANDBOX_ALLOW_DANGEROUS_PACKAGES=false

# ─── Database ────────────────────────────────
# Where to store the SQLite database
# Default: ~/.synapsis/sessions.db
# DATABASE_PATH=

# ─── Debugging ───────────────────────────────
# Log level
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Persist Blackboard entries to database
# true or false
BLACKBOARD_PERSIST=false